{
  "$schema": "http://json.schemastore.org/template",
  "author": "Joseph Meunier",
  "classifications": [
    "Web",
    "ASP.NET Core",
    "Modular Monolith",
    "SaaS"
  ],
  "identity": "Template.SaaS",
